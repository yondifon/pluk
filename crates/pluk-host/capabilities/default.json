{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for every Pluk window",
  "windows": [
    "main",
    "confirm",
    "wande-post"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
