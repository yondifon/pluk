{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for every Pluk window",
  "windows": [
    "main",
    "confirm"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "notification:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
