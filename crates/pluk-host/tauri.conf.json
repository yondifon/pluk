{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluk",
  "version": "0.1.0",
  "identifier": "com.pluk.app",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pluk",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"]
  }
}
