{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluk",
  "version": "0.1.0",
  "identifier": "com.pluk.app",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pluk",
        "width": 1040,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://example.com/updates/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
