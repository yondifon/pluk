# Copy to .env and fill every value from 1Password, or generate it directly:
#   op inject -i .env.1password -o .env
# .env is gitignored — never commit it. Precedence: scripts/publish.sh sources
# .env when it exists; only falls back to resolving .env.1password live via
# `op run` when .env is absent. See docs/release-checklist.md for the full
# runbook and where each 1Password reference lives.

# ── macOS code signing & notarization ────────────────────────────────────────

# Developer ID Application identity — the exact string codesign matches
# against the certificate already in the login keychain (not the certificate
# itself; see docs/release-checklist.md for how the certificate gets there).
# 1Password: op://DesgnSpace/Pluk-signing/APPLE_SIGNING_IDENTITY
APPLE_SIGNING_IDENTITY=

# Apple ID email used for notarization (xcrun notarytool).
# 1Password: op://DesgnSpace/Pluk-signing/APPLE_ID
APPLE_ID=

# App-specific password for that Apple ID (generate at appleid.apple.com).
# 1Password: op://DesgnSpace/Pluk-signing/APPLE_PASSWORD
APPLE_PASSWORD=

# Apple Developer Team ID (10 characters).
# 1Password: op://DesgnSpace/Pluk-signing/APPLE_TEAM_ID
APPLE_TEAM_ID=

# ── Tauri updater signing ────────────────────────────────────────────────────

# Minisign private key content (the file at ~/.tauri/pluk.key, not its path)
# that signs update artifacts. The matching public key is committed in
# crates/pluk-host/tauri.conf.json > plugins.updater.pubkey — not a secret.
# 1Password: op://DesgnSpace/Pluk-signing/TAURI_SIGNING_PRIVATE_KEY
TAURI_SIGNING_PRIVATE_KEY=

# Password for that private key, if one was set when it was generated. Leave
# empty if it wasn't.
# 1Password: op://DesgnSpace/Pluk-signing/TAURI_SIGNING_PRIVATE_KEY_PASSWORD
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ── App runtime (optional overrides — not secrets, no 1Password entry) ──────

# Overrides where Pluk stores its SQLite database, config cache, and logs.
# Leave empty to use the OS default (~/.pluk).
PLUK_DATA_DIR=

# Overrides the local MCP gateway port. Leave empty to use 4242.
PORT=
